DATABASE_URL=postgres://q_nexus:replace-this-password@127.0.0.1:5432/q_nexus
BACKUP_PASSPHRASE=replace-with-a-long-random-secret
BACKUP_TARGET_DIR=.data/backups
# 品集向独立应用签发短期入口授权时使用；至少 32 个字符。
APP_GATEWAY_SECRET=replace-with-at-least-32-random-characters
APP_GATEWAY_ALLOWED_HOSTS=quality-server.local,192.168.60.9,localhost,127.0.0.1
APP_GATEWAY_YIELD_PORT=8504
# Optional identity protection overrides; defaults are 5 failures / 15 minutes.
# Q_NEXUS_MAX_LOGIN_FAILURES=5
# Q_NEXUS_LOCKOUT_MINUTES=15
# Q_NEXUS_BROWSER_SESSION_SECONDS=43200
# Set this when the reverse proxy serves the application over HTTPS.
# Q_NEXUS_HTTPS=1
